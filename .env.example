# Public — safe to ship to the browser bundle (RLS-gated anon key)
NEXT_PUBLIC_SUPABASE_URL=https://gbwusopifbyhlcppbfnl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Address typeahead — Google Places (recommended).
# Enable "Places API" on the key in Google Cloud Console.
# Restrict the key to Places API + (optional) server IP / Vercel.
# Without this key the site falls back to weaker OpenStreetMap Photon.
GOOGLE_MAPS_API_KEY=

# Browser autofill still works via autocomplete attributes either way.

# Server only — NEVER prefix with NEXT_PUBLIC_. Bypasses RLS. Used only in
# app/api/register/route.js, app/api/register/sign/route.js, and
# app/api/keepalive/route.js.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to HMAC-sign the scorekeeper door's session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this instantly logs out every active scorekeeper session.
SCOREKEEPER_SESSION_SECRET=

# There is no email/SMS config here on purpose. NO OUTBOUND COMMS is a hard
# constraint (JD ruling, 2026-07-21) — this is a test site. Registrations
# save and generate a signed PDF locally; nothing is ever sent externally.
# "Who gets notified of what" is a future admin-panel feature, not built yet.
